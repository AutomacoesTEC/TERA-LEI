# Token do bot Telegram (obtido via @BotFather)
TELEGRAM_BOT_TOKEN=123456789:AABBccDDeeFFggHH-IIJJ

# ID do chat ou canal que receberá as notificações
# Use @username para canais públicos ou o ID numérico para grupos/canais privados
TELEGRAM_CHAT_ID=-1001234567890

# Fuso horário
TIMEZONE=America/Sao_Paulo

# Argumentos extras para o Chromium/Puppeteer (necessário no CI)
PUPPETEER_ARGS=--no-sandbox
