{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tera-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "TERA_USERS",
      "id": "SUBSTITUA_PELO_ID_REAL_DO_TERA_USERS"
    },
    {
      "binding": "TERA_DATA",
      "id": "SUBSTITUA_PELO_ID_REAL_DO_TERA_DATA"
    },
    {
      "binding": "TERA_INVITES",
      "id": "SUBSTITUA_PELO_ID_REAL_DO_TERA_INVITES"
    }
  ]
  // Variáveis de ambiente — configure via dashboard ou wrangler secret put:
  //   JWT_SECRET         (obrigatório — string longa aleatória)
  //   ANTHROPIC_API_KEY  (opcional — fallback global se usuário não tiver chave própria)
}
